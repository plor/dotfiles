max-history=3
anchor=top-center

font=monospace 14
text-color=#000000ff
text-alignment=center
width=600
height=400
outer-margin=10
margin=20
padding=15
border-size=1
border-color=#999999ff
progress-color=over #444444ff
border-radius=3

[urgency=low]
background-color=#888888aa
default-timeout=2000

[urgency=normal]
background-color=#666666cc
default-timeout=10000

[urgency=critical]
background-color=#ff4444ee
default-timeout=0
